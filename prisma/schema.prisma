generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  candidate
  employer
  recruiter
  admin
}

enum JobStatus {
  draft
  pending
  active
  expired
  rejected
}

enum PipelineStage {
  new
  screening
  shortlisted
  interview
  selected
  offered
  joined
}

enum DeletionStatus {
  pending
  processing
  completed
  rejected
}

model User {
  id           String    @id
  email        String    @unique
  phone        String?
  passwordHash String?
  name         String
  role         UserRole
  disabled     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  candidate     CandidateProfile?
  employer      EmployerProfile?
  recruiter     RecruiterProfile?
  notifications Notification[]
  activityLogs  ActivityLog[]
  savedJobs     SavedJob[]
  otpChallenges OtpChallenge[]
  deletionRequests DeletionRequest[]
}

model CandidateProfile {
  id                 String   @id
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone              String   @default("")
  photoInitials      String   @default("")
  location           String   @default("")
  currentTitle       String   @default("")
  expectedSalary     Int      @default(0)
  preferredLocations String[] @default([])
  noticePeriod       String   @default("")
  linkedin           String   @default("")
  skills             String[] @default([])
  education          Json     @default("[]")
  experience         Json     @default("[]")
  resumeName         String   @default("")
  resumeUrl          String?
  completeness       Int      @default(0)
  tags               String[] @default([])
  duplicateOfId      String?

  applications  Application[]
  resumes       Resume[]
  interviews    Interview[]
  notes         CandidateNote[]
  pipelineItems PipelineItem[]
}

model EmployerProfile {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
}

model RecruiterProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id        String  @id
  slug      String  @unique
  name      String
  industry  String
  location  String
  website   String  @default("")
  about     String  @default("")
  employees String  @default("")
  founded   String  @default("")
  logoColor String  @default("#111111")
  verified  Boolean @default(false)
  hiring    Boolean @default(true)

  jobs      Job[]
  employers EmployerProfile[]
  clients   Client[]
  invoices  Invoice[]
}

model Job {
  id               String    @id
  slug             String    @unique
  title            String
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  department       String
  category         String
  description      String
  responsibilities String[]  @default([])
  requirements     String[]  @default([])
  skills           String[]  @default([])
  location         String
  employmentType   String
  workMode         String
  experienceMin    Int
  experienceMax    Int
  salaryMin        Int
  salaryMax        Int
  openings         Int
  deadline         DateTime?
  postedAt         DateTime  @default(now())
  featured         Boolean   @default(false)
  status           JobStatus @default(pending)

  applications  Application[]
  interviews    Interview[]
  assignments   RecruitmentAssignment[]
  pipelineItems PipelineItem[]
  savedBy       SavedJob[]

  @@index([category, location, status])
}

model Application {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      String   @default("Applied")
  appliedAt   DateTime @default(now())
  timeline    Json     @default("[]")
  interviews  Interview[]

  @@unique([jobId, candidateId])
}

model Resume {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileName    String
  storageKey  String
  mimeType    String?
  version     Int              @default(1)
  createdAt   DateTime         @default(now())
}

model Interview {
  id            String           @id @default(cuid())
  applicationId String?
  application   Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  jobId         String
  job           Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyId     String
  scheduledAt   DateTime
  mode          String
  location      String
  interviewer   String
  status        String           @default("Scheduled")
}

model Client {
  id           String  @id
  companyId    String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountOwner String
  openRoles    Int     @default(0)
  sla          String
}

model RecruitmentAssignment {
  id          String @id @default(cuid())
  jobId       String
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recruiterId String
}

model CandidateNote {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  author      String
  body        String
  createdAt   DateTime         @default(now())
}

model PipelineItem {
  id          String           @id
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage       PipelineStage
  recruiterId String
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
}

model Lead {
  id          String   @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String
  hiringNeed  String
  roles       String   @default("")
  location    String   @default("")
  status      String   @default("New")
  createdAt   DateTime @default(now())
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String   @default("")
  message   String
  createdAt DateTime @default(now())
}

model Placement {
  id          String   @id @default(cuid())
  candidateId String
  jobId       String
  joinedAt    DateTime
  ctc         Int
}

model Invoice {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  amount            Int
  currency          String   @default("INR")
  status            String   @default("created")
  packageName       String   @default("Job package")
  razorpayOrderId   String?
  razorpayPaymentId String?
  issuedAt          DateTime @default(now())
  paidAt            DateTime?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PlatformSettings {
  id                 String  @id @default("default")
  emailUpdates       Boolean @default(true)
  whatsappReminders  Boolean @default(false)
}

model OtpChallenge {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  phone     String?
  purpose   String
  codeHash  String
  payload   Json?
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

model DeletionRequest {
  id          String         @id @default(cuid())
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  email       String
  reason      String?
  status      DeletionStatus @default(pending)
  createdAt   DateTime       @default(now())
  completedAt DateTime?
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  meta      Json?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  createdAt DateTime @default(now())
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  category    String
  readTime    String
  body        String[]
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
