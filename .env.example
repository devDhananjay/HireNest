# PostgreSQL
# Docker Compose: postgresql://postgres:postgres@localhost:5432/hireora
# Homebrew local user (no password): postgresql://YOUR_USER@localhost:5432/hireora
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hireora"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production-use-a-long-random-string"

# Demo OTP fallback when email/SMS providers are unset
OTP_DEV_CODE="123456"

# App (production: https://hireora.in)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
EMAIL_FROM="HIREORA <noreply@hireora.in>"

# Optional OpenAI resume parsing (falls back to heuristic parser)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Email (Resend) — optional; falls back to console
RESEND_API_KEY=""

# WhatsApp — Meta Cloud API (preferred)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="hireora-whatsapp"
WHATSAPP_TEMPLATE_LANG="en"
# Optional approved template names (else session text is used)
WHATSAPP_DEFAULT_TEMPLATE=""
WHATSAPP_INTERVIEW_TEMPLATE=""
WHATSAPP_VOICE_TEMPLATE=""

# Cron jobs (follow-ups + daily digest) — Bearer token for /api/cron/*
CRON_SECRET=""

# WhatsApp fallback (Twilio) — optional if Meta unset
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Object storage (S3 / R2) — optional; falls back to local uploads/
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Razorpay — optional; orders mock when unset
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
